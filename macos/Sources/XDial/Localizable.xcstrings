    "intent.connect.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect XDial"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接 XDial"
          }
        }
      }
    },
    "intent.connect.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connects XDial with the current Scenario. Reports why when XDial needs you to finish something first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按当前场景连接 XDial。需要先在 XDial 里完成的事会作为原因返回。"
          }
        }
      }
    },
    "intent.connect.short": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接"
          }
        }
      }
    },
    "intent.disconnect.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect XDial"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断开 XDial"
          }
        }
      }
    },
    "intent.disconnect.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnects XDial."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断开 XDial 的连接。"
          }
        }
      }
    },
    "intent.disconnect.short": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断开"
          }
        }
      }
    },
    "intent.switch.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch XDial Scenario"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换 XDial 场景"
          }
        }
      }
    },
    "intent.switch.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switches XDial to a Scenario, like choosing it in the menu bar. While connected the new Scenario takes over without a break; otherwise it applies on the next connection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把 XDial 切换到指定场景，和在菜单栏里选择一样。已连接时直接切换，不中断连接；未连接时下次连接生效。"
          }
        }
      }
    },
    "intent.switch.summary ${scenario}": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch XDial to ${scenario}"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把 XDial 切换到 ${scenario}"
          }
        }
      }
    },
    "intent.switch.short": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch Scenario"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换场景"
          }
        }
      }
    },
    "intent.status.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get XDial Status"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获取 XDial 状态"
          }
        }
      }
    },
    "intent.status.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Returns whether XDial is connected and which Scenario is active. Changes nothing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回 XDial 是否已连接以及当前场景，不做任何改动。"
          }
        }
      }
    },
    "intent.status.short": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态"
          }
        }
      }
    }
