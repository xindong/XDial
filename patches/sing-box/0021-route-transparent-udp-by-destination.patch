+package socks
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"net"
+	"os"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing/common/buf"
+	"github.com/sagernet/sing/common/cache"
+	"github.com/sagernet/sing/common/canceler"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/common/pipe"
+	"github.com/sagernet/sing/protocol/socks"
+)
+
+const (
+	xdialUDPMaxDatagram = 65535
+	xdialUDPMaxTargets  = 64
+	xdialUDPQueueSize   = 16
+)
+
+// sing's SOCKS handshake discovers the UDP client by reading its first packet.
+// Keep that client address fixed while independently routed targets reply.
+type xdialUDPListener struct {
+	socks.PacketListener
+	control net.Conn
+	socket  *xdialUDPSocket
+}
+
+func (l *xdialUDPListener) ListenPacket(config net.ListenConfig, ctx context.Context, network, address string) (net.PacketConn, error) {
+	conn, err := l.PacketListener.ListenPacket(config, ctx, network, address)
+	if err != nil {
+		return nil, err
+	}
+	l.socket = &xdialUDPSocket{PacketConn: conn}
+	// UDP ASSOCIATE ends on control EOF, including while waiting for its first packet.
+	go func() {
+		_, _ = io.Copy(io.Discard, l.control)
+		_ = conn.Close()
+	}()
+	return l.socket, nil
+}
+
+type xdialUDPSocket struct {
+	net.PacketConn
+	peer  net.Addr // set during the handshake, before starting any writers
+	first []byte
+}
+
+// Only the upstream handshake uses ReadFrom. Its discovery buffer can be
+// smaller than the wire datagram. Replay the complete first packet to Read.
+func (s *xdialUDPSocket) ReadFrom(b []byte) (int, net.Addr, error) {
+	packet := buf.NewSize(xdialUDPMaxDatagram)
+	defer packet.Release()
+	n, peer, err := s.PacketConn.ReadFrom(packet.FreeBytes())
+	if err != nil {
+		return 0, nil, err
+	}
+	s.peer = peer
+	s.first = bytes.Clone(packet.FreeBytes()[:n])
+	return copy(b, s.first), peer, nil
+}
+
+func (s *xdialUDPSocket) Read(b []byte) (int, error) {
+	if s.first != nil {
+		n := copy(b, s.first)
+		s.first = nil
+		return n, nil
+	}
+	for {
+		n, peer, err := s.PacketConn.ReadFrom(b)
+		if err != nil || M.SocksaddrFromNet(peer) == M.SocksaddrFromNet(s.peer) {
+			return n, err
+		}
+	}
+}
+
+func (s *xdialUDPSocket) Write(b []byte) (int, error) { return s.WriteTo(b, s.peer) }
+func (s *xdialUDPSocket) RemoteAddr() net.Addr        { return s.peer }
+
+func (h *Inbound) routeXDialUDP(ctx context.Context, association *xdialUDPListener, handshake N.PacketConn, metadata adapter.InboundContext, onClose N.CloseHandlerFunc) {
+	ctx, cancel := context.WithCancel(ctx)
+	relay := socks.NewAssociatePacketConn(association.socket, M.Socksaddr{}, association.control)
+	ctx, packets := canceler.NewPacketConn(ctx, relay, h.udpTimeout)
+	stop := context.AfterFunc(ctx, func() { _ = association.socket.Close() })
+	var err error
+	defer func() {
+		stop()
+		cancel()
+		_ = packets.Close()
+		_ = handshake.Close()
+		if onClose != nil {
+			onClose(err)
+		}
+	}()
+
+	if isXDialBoundAssociationMarker(metadata.Destination) {
+		if _, err = applyXDialFlowMetadata(&metadata); err != nil {
+			h.logger.ErrorContext(ctx, "reject invalid XDial bound association")
+			return
+		}
+	}
+	reader := newXDialBoundMarkerFilterConn(packets)
+	targets := cache.New(
+		cache.WithSize[M.Socksaddr, *xdialUDPTarget](xdialUDPMaxTargets),
+		cache.WithEvict(func(_ M.Socksaddr, target *xdialUDPTarget) { target.Close() }),
+	)
+	packet := buf.NewSize(xdialUDPMaxDatagram)
+	defer packet.Release()
+	for {
+		packet.Reset()
+		var destination M.Socksaddr
+		destination, err = reader.ReadPacket(packet)
+		if err != nil {
+			return
+		}
+		target, ok := targets.Load(destination)
+		if !ok || target.ctx.Err() != nil {
+			peer := metadata
+			peer.Destination = destination
+			if _, err = applyXDialFlowMetadata(&peer); err != nil {
+				h.logger.ErrorContext(ctx, "reject invalid XDial flow metadata")
+				continue
+			}
+			peerCtx, end := context.WithCancel(ctx)
+			target = &xdialUDPTarget{
+				ctx: peerCtx, end: end, writer: packets, local: relay.LocalAddr(),
+				destination: peer.Destination, queue: make(chan []byte, xdialUDPQueueSize),
+				deadline: pipe.MakeDeadline(),
+			}
+			targets.Store(destination, target)
+			timedCtx, timedConn := canceler.NewPacketConn(peerCtx, target, h.udpTimeout)
+			go h.streamUserPacketConnection(timedCtx, timedConn, peer, func(error) { end() })
+		}
+		// The association has one producer. A slow target drops its own excess
+		// datagrams without delaying another target's route or allocating a copy.
+		if len(target.queue) < cap(target.queue) {
+			target.queue <- bytes.Clone(packet.Bytes())
+		}
+	}
+}
+
+type xdialUDPTarget struct {
+	ctx         context.Context
+	end         context.CancelFunc
+	writer      N.PacketWriter
+	local       net.Addr
+	destination M.Socksaddr
+	queue       chan []byte
+	deadline    pipe.Deadline
+	readOptions N.ReadWaitOptions
+}
+
+func (p *xdialUDPTarget) nextPacket() ([]byte, error) {
+	select {
+	case <-p.ctx.Done():
+		return nil, net.ErrClosed
+	case <-p.deadline.Wait():
+		return nil, os.ErrDeadlineExceeded
+	case data := <-p.queue:
+		// Cancellation and a queued datagram can both be ready after eviction.
+		if p.ctx.Err() != nil {
+			return nil, net.ErrClosed
+		}
+		return data, nil
+	}
+}
+
+func (p *xdialUDPTarget) ReadPacket(buffer *buf.Buffer) (M.Socksaddr, error) {
+	data, err := p.nextPacket()
+	if err != nil {
+		return M.Socksaddr{}, err
+	}
+	if len(data) > buffer.FreeLen() {
+		return M.Socksaddr{}, io.ErrShortBuffer
+	}
+	_, err = buffer.Write(data)
+	return p.destination, err
+}
+
+func (p *xdialUDPTarget) InitializeReadWaiter(options N.ReadWaitOptions) bool {
+	p.readOptions = options
+	return false
+}
+
+func (p *xdialUDPTarget) WaitReadPacket() (*buf.Buffer, M.Socksaddr, error) {
+	data, err := p.nextPacket()
+	if err != nil {
+		return nil, M.Socksaddr{}, err
+	}
+	packet := p.readOptions.NewBufferSize(len(data))
+	_, _ = packet.Write(data)
+	p.readOptions.PostReturn(packet)
+	return packet, p.destination, nil
+}
+
+func (p *xdialUDPTarget) WritePacket(packet *buf.Buffer, source M.Socksaddr) error {
+	if p.ctx.Err() != nil {
+		packet.Release()
+		return net.ErrClosed
+	}
+	return p.writer.WritePacket(packet, source)
+}
+
+func (p *xdialUDPTarget) Close() error {
+	p.end()
+	return nil
+}
+
+func (p *xdialUDPTarget) SetReadDeadline(t time.Time) error {
+	p.deadline.Set(t)
+	return nil
+}
+
+func (p *xdialUDPTarget) FrontHeadroom() int               { return N.CalculateFrontHeadroom(p.writer) }
+func (p *xdialUDPTarget) LocalAddr() net.Addr              { return p.local }
+func (p *xdialUDPTarget) SetDeadline(time.Time) error      { return os.ErrInvalid }
+func (p *xdialUDPTarget) SetWriteDeadline(time.Time) error { return os.ErrInvalid }
