+package socks
+
+import (
+	"context"
+	"net"
+	"net/netip"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing/common/buf"
+	M "github.com/sagernet/sing/common/metadata"
+
+	"github.com/stretchr/testify/require"
+)
+
+type xdialFallbackCapture struct {
+	headroom int
+	ch       chan xdialFallbackPacket
+}
+
+type xdialFallbackPacket struct {
+	payload []byte
+	source  M.Socksaddr
+}
+
+func (c *xdialFallbackCapture) WritePacket(buffer *buf.Buffer, destination M.Socksaddr) error {
+	defer buffer.Release()
+	if buffer.Start() < c.headroom {
+		panic("fallback packet missing required front headroom")
+	}
+	payload := append([]byte(nil), buffer.Bytes()...)
+	c.ch <- xdialFallbackPacket{payload: payload, source: destination}
+	return nil
+}
+
+func (c *xdialFallbackCapture) FrontHeadroom() int {
+	return c.headroom
+}
+
+func TestXDialDirectPacketPoolSharesSingleSocketAcrossPeers(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+
+	fallback := &xdialFallbackCapture{
+		headroom: 3 + M.MaxSocksaddrLength,
+		ch:       make(chan xdialFallbackPacket, 8),
+	}
+	pool := newXDialDirectPacketPool(ctx, fallback)
+	defer pool.Close()
+
+	peer1, err := net.ListenPacket("udp4", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer peer1.Close()
+	peer2, err := net.ListenPacket("udp4", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer peer2.Close()
+	peer3, err := net.ListenPacket("udp4", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer peer3.Close()
+
+	deadline := time.Now().Add(5 * time.Second)
+	require.NoError(t, peer1.SetDeadline(deadline))
+	require.NoError(t, peer2.SetDeadline(deadline))
+	require.NoError(t, peer3.SetDeadline(deadline))
+
+	var openCount atomic.Int32
+	openSocket := func(context.Context) (net.PacketConn, error) {
+		openCount.Add(1)
+		return net.ListenPacket("udp4", "127.0.0.1:0")
+	}
+
+	key := adapter.XDialDirectPacketSocketKey{Outbound: "direct"}
+	h1, err := pool.Acquire(ctx, key, M.SocksaddrFromNet(peer1.LocalAddr()), openSocket)
+	require.NoError(t, err)
+	h2, err := pool.Acquire(ctx, key, M.SocksaddrFromNet(peer2.LocalAddr()), openSocket)
+	require.NoError(t, err)
+	require.Equal(t, int32(1), openCount.Load())
+	require.Equal(t, h1.LocalAddr().String(), h2.LocalAddr().String())
+	require.NoError(t, h1.SetReadDeadline(deadline))
+	require.NoError(t, h2.SetReadDeadline(deadline))
+
+	// Send to two different direct peers and verify both see the exact same source endpoint.
+	_, err = h1.WriteTo([]byte("hello-1"), peer1.LocalAddr())
+	require.NoError(t, err)
+	_, err = h2.WriteTo([]byte("hello-2"), peer2.LocalAddr())
+	require.NoError(t, err)
+
+	buf1 := make([]byte, 64)
+	n1, seenFrom1, err := peer1.ReadFrom(buf1)
+	require.NoError(t, err)
+	require.Equal(t, "hello-1", string(buf1[:n1]))
+
+	buf2 := make([]byte, 64)
+	n2, seenFrom2, err := peer2.ReadFrom(buf2)
+	require.NoError(t, err)
+	require.Equal(t, "hello-2", string(buf2[:n2]))
+	require.Equal(t, seenFrom1.String(), seenFrom2.String(), "both peers must observe the same outbound UDP port")
+
+	// Replies route back to their own handles with exact remote addresses.
+	_, err = peer1.WriteTo([]byte("reply-1"), seenFrom1)
+	require.NoError(t, err)
+	_, err = peer2.WriteTo([]byte("reply-2"), seenFrom2)
+	require.NoError(t, err)
+
+	n1, replyFrom1, err := h1.ReadFrom(buf1)
+	require.NoError(t, err)
+	require.Equal(t, "reply-1", string(buf1[:n1]))
+	require.Equal(t, peer1.LocalAddr().String(), replyFrom1.String())
+
+	n2, replyFrom2, err := h2.ReadFrom(buf2)
+	require.NoError(t, err)
+	require.Equal(t, "reply-2", string(buf2[:n2]))
+	require.Equal(t, peer2.LocalAddr().String(), replyFrom2.String())
+
+	// Closing handle 1 must NOT close the shared socket for handle 2.
+	require.NoError(t, h1.Close())
+	_, err = h2.WriteTo([]byte("still-alive"), peer2.LocalAddr())
+	require.NoError(t, err)
+	n2, seenAgain, err := peer2.ReadFrom(buf2)
+	require.NoError(t, err)
+	require.Equal(t, "still-alive", string(buf2[:n2]))
+	require.Equal(t, seenFrom2.String(), seenAgain.String())
+
+	// Unsolicited Full-Cone packet from peer 3 arrives via fallback writer with exact source.
+	_, err = peer3.WriteTo([]byte("punch-from-peer3"), seenFrom1)
+	require.NoError(t, err)
+	select {
+	case unsolicited := <-fallback.ch:
+		require.Equal(t, "punch-from-peer3", string(unsolicited.payload))
+		require.Equal(t, M.SocksaddrFromNet(peer3.LocalAddr()), unsolicited.source)
+	case <-time.After(3 * time.Second):
+		t.Fatal("timed out waiting for unsolicited Full-Cone packet")
+	}
+
+	// Closing the pool closes the shared OS socket and wakes blocked readers.
+	readDone := make(chan error, 1)
+	go func() {
+		_, _, readErr := h2.ReadFrom(make([]byte, 64))
+		readDone <- readErr
+	}()
+	pool.Close()
+	select {
+	case readErr := <-readDone:
+		require.Error(t, readErr)
+	case <-time.After(3 * time.Second):
+		t.Fatal("handle ReadFrom did not unblock after pool close")
+	}
+}
+
+func TestXDialDirectPacketPoolIsolatesKeysAndConcurrentAcquire(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+
+	pool := newXDialDirectPacketPool(ctx, nil)
+	defer pool.Close()
+
+	var opens atomic.Int32
+	openSocket := func(context.Context) (net.PacketConn, error) {
+		opens.Add(1)
+		return net.ListenPacket("udp4", "127.0.0.1:0")
+	}
+
+	keyA := adapter.XDialDirectPacketSocketKey{Outbound: "direct"}
+	const workers = 16
+	handles := make([]net.PacketConn, workers)
+	var wg sync.WaitGroup
+	wg.Add(workers)
+	for i := 0; i < workers; i++ {
+		go func(idx int) {
+			defer wg.Done()
+			h, err := pool.Acquire(ctx, keyA, M.ParseSocksaddrHostPort("127.0.0.1", uint16(10000+idx)), openSocket)
+			require.NoError(t, err)
+			handles[idx] = h
+		}(i)
+	}
+	wg.Wait()
+	require.Equal(t, int32(1), opens.Load())
+	sharedAddr := handles[0].LocalAddr().String()
+	for _, h := range handles {
+		require.Equal(t, sharedAddr, h.LocalAddr().String())
+	}
+
+	// Different outbound tag, bound interface, or IP address family gets its own socket.
+	keyB := adapter.XDialDirectPacketSocketKey{Outbound: "direct-alt"}
+	keyBound := adapter.XDialDirectPacketSocketKey{Outbound: "direct", BoundInterface: "en0"}
+	keyV6 := adapter.XDialDirectPacketSocketKey{Outbound: "direct", IPv6: true}
+	hB, err := pool.Acquire(ctx, keyB, M.ParseSocksaddr("127.0.0.1:20001"), openSocket)
+	require.NoError(t, err)
+	hBound, err := pool.Acquire(ctx, keyBound, M.ParseSocksaddr("127.0.0.1:20002"), openSocket)
+	require.NoError(t, err)
+	hV6, err := pool.Acquire(ctx, keyV6, M.ParseSocksaddr("[::1]:20003"), openSocket)
+	require.NoError(t, err)
+	require.Equal(t, int32(4), opens.Load())
+	require.NotEqual(t, sharedAddr, hB.LocalAddr().String())
+	require.NotEqual(t, sharedAddr, hBound.LocalAddr().String())
+	require.NotEqual(t, sharedAddr, hV6.LocalAddr().String())
+	require.NotEqual(t, hB.LocalAddr().String(), hBound.LocalAddr().String())
+	require.NotEqual(t, hB.LocalAddr().String(), hV6.LocalAddr().String())
+	require.NotEqual(t, hBound.LocalAddr().String(), hV6.LocalAddr().String())
+
+	// IPv4-mapped IPv6 peers normalize to the same IPv4 peer key as plain IPv4.
+	mappedPeer, ok := xdialDirectPeerKey(M.SocksaddrFrom(netip.MustParseAddr("::ffff:127.0.0.1"), 5000))
+	require.True(t, ok)
+	plainPeer, ok := xdialDirectPeerKey(M.SocksaddrFrom(netip.MustParseAddr("127.0.0.1"), 5000))
+	require.True(t, ok)
+	require.Equal(t, plainPeer, mappedPeer)
+	require.True(t, mappedPeer.Addr().Is4())
+
+	for _, h := range handles {
+		require.NoError(t, h.Close())
+	}
+	require.NoError(t, hB.Close())
+	require.NoError(t, hBound.Close())
+	require.NoError(t, hV6.Close())
+}
