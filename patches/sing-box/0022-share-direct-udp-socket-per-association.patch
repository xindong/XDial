+package socks
+
+import (
+	"bytes"
+	"context"
+	"net"
+	"net/netip"
+	"os"
+	"sync"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing/common/buf"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/common/pipe"
+)
+
+const xdialUDPDirectQueueSize = 64
+
+// xdialDirectPacketPool owns the shared unconnected Direct UDP sockets for one
+// transparent-proxy SOCKS5 UDP association.
+//
+// Each destination still goes through sing-box routing independently (so
+// Direct, VPN, Proxy, and Reject never mix), while destinations that land on
+// the same Direct outbound, bound interface, and address family share one OS
+// UDP socket. All direct peers therefore observe one stable source port
+// (Endpoint-Independent Mapping / Full-Cone NAT semantics), and unsolicited
+// packets arriving on that socket are delivered back to the association with
+// their original remote source address.
+type xdialDirectPacketPool struct {
+	ctx      context.Context
+	fallback N.PacketWriter
+
+	mu      sync.Mutex
+	closed  bool
+	sockets map[adapter.XDialDirectPacketSocketKey]*xdialSharedDirectSocket
+}
+
+func newXDialDirectPacketPool(ctx context.Context, fallback N.PacketWriter) *xdialDirectPacketPool {
+	return &xdialDirectPacketPool{
+		ctx:      ctx,
+		fallback: fallback,
+		sockets:  make(map[adapter.XDialDirectPacketSocketKey]*xdialSharedDirectSocket),
+	}
+}
+
+func (p *xdialDirectPacketPool) Acquire(
+	reqCtx context.Context,
+	key adapter.XDialDirectPacketSocketKey,
+	initialPeer M.Socksaddr,
+	open func(context.Context) (net.PacketConn, error),
+) (net.PacketConn, error) {
+	if err := reqCtx.Err(); err != nil {
+		return nil, err
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.closed || p.ctx.Err() != nil {
+		return nil, net.ErrClosed
+	}
+	if socket := p.sockets[key]; socket != nil {
+		if handle, err := socket.newHandle(initialPeer); err == nil {
+			return handle, nil
+		}
+		delete(p.sockets, key)
+	}
+	openCtx := p.ctx
+	if metadata := adapter.ContextFrom(reqCtx); metadata != nil {
+		openCtx = adapter.WithContext(openCtx, metadata)
+	}
+	raw, err := open(openCtx)
+	if err != nil {
+		return nil, err
+	}
+	socket := newXDialSharedDirectSocket(raw, p.fallback)
+	handle, err := socket.newHandle(initialPeer)
+	if err != nil {
+		_ = raw.Close()
+		return nil, err
+	}
+	p.sockets[key] = socket
+	go socket.readLoop(func(readErr error) {
+		p.removeSocket(key, socket)
+		socket.closeWithError(readErr)
+	})
+	return handle, nil
+}
+
+func (p *xdialDirectPacketPool) removeSocket(key adapter.XDialDirectPacketSocketKey, socket *xdialSharedDirectSocket) {
+	p.mu.Lock()
+	if p.sockets[key] == socket {
+		delete(p.sockets, key)
+	}
+	p.mu.Unlock()
+}
+
+func (p *xdialDirectPacketPool) Close() {
+	p.mu.Lock()
+	if p.closed {
+		p.mu.Unlock()
+		return
+	}
+	p.closed = true
+	sockets := make([]*xdialSharedDirectSocket, 0, len(p.sockets))
+	for key, socket := range p.sockets {
+		sockets = append(sockets, socket)
+		delete(p.sockets, key)
+	}
+	p.mu.Unlock()
+	for _, socket := range sockets {
+		socket.closeWithError(net.ErrClosed)
+	}
+}
+
+type xdialSharedDatagram struct {
+	data   []byte
+	source M.Socksaddr
+}
+
+type xdialSharedDirectSocket struct {
+	raw      net.PacketConn
+	fallback N.PacketWriter
+
+	mu      sync.RWMutex
+	closed  bool
+	err     error
+	handles map[*xdialSharedDirectHandle]struct{}
+	routes  map[netip.AddrPort]*xdialSharedDirectHandle
+}
+
+func newXDialSharedDirectSocket(raw net.PacketConn, fallback N.PacketWriter) *xdialSharedDirectSocket {
+	return &xdialSharedDirectSocket{
+		raw:      raw,
+		fallback: fallback,
+		handles:  make(map[*xdialSharedDirectHandle]struct{}),
+		routes:   make(map[netip.AddrPort]*xdialSharedDirectHandle),
+	}
+}
+
+func (s *xdialSharedDirectSocket) newHandle(initialPeer M.Socksaddr) (*xdialSharedDirectHandle, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closed {
+		if s.err != nil {
+			return nil, s.err
+		}
+		return nil, net.ErrClosed
+	}
+	handle := &xdialSharedDirectHandle{
+		socket:   s,
+		queue:    make(chan xdialSharedDatagram, xdialUDPDirectQueueSize),
+		done:     make(chan struct{}),
+		deadline: pipe.MakeDeadline(),
+		peers:    make(map[netip.AddrPort]struct{}, 1),
+	}
+	s.handles[handle] = struct{}{}
+	if peer, ok := xdialDirectPeerKey(initialPeer); ok {
+		s.registerPeerLocked(handle, peer)
+	}
+	return handle, nil
+}
+
+func (s *xdialSharedDirectSocket) registerPeerLocked(handle *xdialSharedDirectHandle, peer netip.AddrPort) {
+	if previous := s.routes[peer]; previous != nil && previous != handle {
+		delete(previous.peers, peer)
+	}
+	s.routes[peer] = handle
+	handle.peers[peer] = struct{}{}
+}
+
+func (s *xdialSharedDirectSocket) ensurePeer(handle *xdialSharedDirectHandle, peer netip.AddrPort) bool {
+	s.mu.RLock()
+	if !s.closed && s.routes[peer] == handle {
+		s.mu.RUnlock()
+		return true
+	}
+	s.mu.RUnlock()
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closed {
+		return false
+	}
+	if _, active := s.handles[handle]; !active {
+		return false
+	}
+	if s.routes[peer] != handle {
+		s.registerPeerLocked(handle, peer)
+	}
+	return true
+}
+
+func (s *xdialSharedDirectSocket) detachHandle(handle *xdialSharedDirectHandle) {
+	s.mu.Lock()
+	if _, active := s.handles[handle]; active {
+		delete(s.handles, handle)
+		for peer := range handle.peers {
+			if s.routes[peer] == handle {
+				delete(s.routes, peer)
+			}
+		}
+		clear(handle.peers)
+	}
+	s.mu.Unlock()
+}
+
+func (s *xdialSharedDirectSocket) closeWithError(err error) {
+	if err == nil {
+		err = net.ErrClosed
+	}
+	s.mu.Lock()
+	if s.closed {
+		s.mu.Unlock()
+		return
+	}
+	s.closed = true
+	s.err = err
+	handles := make([]*xdialSharedDirectHandle, 0, len(s.handles))
+	for handle := range s.handles {
+		handles = append(handles, handle)
+		clear(handle.peers)
+	}
+	clear(s.handles)
+	clear(s.routes)
+	s.mu.Unlock()
+
+	_ = s.raw.Close()
+	for _, handle := range handles {
+		handle.closeLocal(err)
+	}
+}
+
+func (s *xdialSharedDirectSocket) readLoop(onExit func(error)) {
+	buffer := buf.NewSize(xdialUDPMaxDatagram)
+	defer buffer.Release()
+	for {
+		buffer.Reset()
+		n, remoteAddr, err := s.raw.ReadFrom(buffer.FreeBytes())
+		if err != nil {
+			onExit(err)
+			return
+		}
+		source := M.SocksaddrFromNet(remoteAddr).Unwrap()
+		if !source.IsValid() {
+			continue
+		}
+		var target *xdialSharedDirectHandle
+		if peer, ok := xdialDirectPeerKey(source); ok {
+			s.mu.RLock()
+			target = s.routes[peer]
+			s.mu.RUnlock()
+		}
+		payload := buffer.FreeBytes()[:n]
+		if target != nil && target.enqueue(bytes.Clone(payload), source) {
+			continue
+		}
+		s.writeFallback(payload, source)
+	}
+}
+
+func (s *xdialSharedDirectSocket) writeFallback(payload []byte, source M.Socksaddr) {
+	if s.fallback == nil {
+		return
+	}
+	frontHeadroom := N.CalculateFrontHeadroom(s.fallback)
+	rearHeadroom := N.CalculateRearHeadroom(s.fallback)
+	packet := buf.NewSize(frontHeadroom + len(payload) + rearHeadroom)
+	packet.Resize(frontHeadroom, 0)
+	_, _ = packet.Write(payload)
+	_ = s.fallback.WritePacket(packet, source)
+}
+
+type xdialSharedDirectHandle struct {
+	socket   *xdialSharedDirectSocket
+	queue    chan xdialSharedDatagram
+	done     chan struct{}
+	deadline pipe.Deadline
+
+	closeOnce sync.Once
+	errMu     sync.Mutex
+	closeErr  error
+	peers     map[netip.AddrPort]struct{} // guarded by socket.mu
+}
+
+func (h *xdialSharedDirectHandle) enqueue(data []byte, source M.Socksaddr) bool {
+	select {
+	case <-h.done:
+		return false
+	default:
+	}
+	select {
+	case <-h.done:
+		return false
+	case h.queue <- xdialSharedDatagram{data: data, source: source}:
+		return true
+	default:
+		// Slow target drops its own excess datagrams without stalling other targets.
+		return true
+	}
+}
+
+func (h *xdialSharedDirectHandle) ReadFrom(p []byte) (int, net.Addr, error) {
+	select {
+	case <-h.done:
+		return 0, nil, h.closedError()
+	case <-h.deadline.Wait():
+		return 0, nil, os.ErrDeadlineExceeded
+	case item := <-h.queue:
+		select {
+		case <-h.done:
+			return 0, nil, h.closedError()
+		default:
+		}
+		n := copy(p, item.data)
+		return n, item.source.UDPAddr(), nil
+	}
+}
+
+func (h *xdialSharedDirectHandle) WriteTo(p []byte, addr net.Addr) (int, error) {
+	select {
+	case <-h.done:
+		return 0, h.closedError()
+	default:
+	}
+	if peer, ok := xdialDirectPeerKey(M.SocksaddrFromNet(addr)); ok {
+		if !h.socket.ensurePeer(h, peer) {
+			return 0, h.closedError()
+		}
+	}
+	return h.socket.raw.WriteTo(p, addr)
+}
+
+func (h *xdialSharedDirectHandle) Close() error {
+	h.socket.detachHandle(h)
+	h.closeLocal(net.ErrClosed)
+	return nil
+}
+
+func (h *xdialSharedDirectHandle) closeLocal(err error) {
+	h.closeOnce.Do(func() {
+		if err == nil {
+			err = net.ErrClosed
+		}
+		h.errMu.Lock()
+		h.closeErr = err
+		h.errMu.Unlock()
+		close(h.done)
+	})
+}
+
+func (h *xdialSharedDirectHandle) closedError() error {
+	h.errMu.Lock()
+	err := h.closeErr
+	h.errMu.Unlock()
+	if err != nil {
+		return err
+	}
+	return net.ErrClosed
+}
+
+func (h *xdialSharedDirectHandle) LocalAddr() net.Addr {
+	return h.socket.raw.LocalAddr()
+}
+
+func (h *xdialSharedDirectHandle) SetDeadline(t time.Time) error {
+	h.deadline.Set(t)
+	return nil
+}
+
+func (h *xdialSharedDirectHandle) SetReadDeadline(t time.Time) error {
+	h.deadline.Set(t)
+	return nil
+}
+
+func (h *xdialSharedDirectHandle) SetWriteDeadline(time.Time) error {
+	return nil
+}
+
+func xdialDirectPeerKey(addr M.Socksaddr) (netip.AddrPort, bool) {
+	addr = addr.Unwrap()
+	if !addr.IsIP() || !addr.Addr.IsValid() || addr.Port == 0 {
+		return netip.AddrPort{}, false
+	}
+	return netip.AddrPortFrom(addr.Addr.Unmap(), addr.Port), true
+}
