+package adapter
+
+import (
+	"context"
+	"net"
+
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+// XDialDirectPacketSocketKey identifies one shared unconnected Direct UDP
+// socket within a single transparent-proxy UDP association.
+//
+// Destinations routed to the same Direct outbound, bound interface, and IP
+// address family reuse one OS UDP socket so every remote endpoint sees the
+// same local source port (Endpoint-Independent Mapping / Full-Cone semantics).
+type XDialDirectPacketSocketKey struct {
+	Outbound       string
+	BoundInterface string
+	IPv6           bool
+}
+
+// XDialDirectPacketPool manages association-scoped shared Direct UDP sockets.
+type XDialDirectPacketPool interface {
+	Acquire(
+		ctx context.Context,
+		key XDialDirectPacketSocketKey,
+		initialPeer M.Socksaddr,
+		open func(context.Context) (net.PacketConn, error),
+	) (net.PacketConn, error)
+}
+
+type xdialDirectPacketPoolKey struct{}
+
+func ContextWithXDialDirectPacketPool(ctx context.Context, pool XDialDirectPacketPool) context.Context {
+	return context.WithValue(ctx, (*xdialDirectPacketPoolKey)(nil), pool)
+}
+
+func XDialDirectPacketPoolFromContext(ctx context.Context) XDialDirectPacketPool {
+	pool, _ := ctx.Value((*xdialDirectPacketPoolKey)(nil)).(XDialDirectPacketPool)
+	return pool
+}
