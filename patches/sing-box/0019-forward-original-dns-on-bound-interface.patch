+package local
+
+import (
+	"context"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/dialer"
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+	N "github.com/sagernet/sing/common/network"
+)
+
+// The macOS Transparent Proxy forwards each captured DNS request to the
+// resolver endpoint the application chose. When that application socket was
+// bound to an interface, the request must leave on the same interface:
+// route.default_interface otherwise pins every unbound sing-box dialer to the
+// pre-start default interface, and a resolver that the complete Underlay only
+// reaches through another interface (for example Tailscale MagicDNS
+// 100.100.100.100 on its utun) silently black-holes. This mirrors the bound
+// interface handling the Direct outbound already applies to ordinary flows.
+func (t *Transport) xdialOriginalQueryDialer(ctx context.Context) (N.Dialer, error) {
+	metadata := adapter.ContextFrom(ctx)
+	if metadata == nil || metadata.XDialBoundInterface == "" {
+		return t.dialer, nil
+	}
+	interfaceName := metadata.XDialBoundInterface
+	t.xdialBoundDialerMu.Lock()
+	defer t.xdialBoundDialerMu.Unlock()
+	if boundDialer := t.xdialBoundDialers[interfaceName]; boundDialer != nil {
+		return boundDialer, nil
+	}
+	boundDialer, err := xdialNewBoundDialer(t.ctx, t.xdialDialerOptions, interfaceName)
+	if err != nil {
+		return nil, E.Cause(err, "create DNS dialer bound to ", interfaceName)
+	}
+	if t.xdialBoundDialers == nil {
+		t.xdialBoundDialers = make(map[string]N.Dialer)
+	}
+	t.xdialBoundDialers[interfaceName] = boundDialer
+	return boundDialer, nil
+}
+
+var xdialNewBoundDialer = func(
+	ctx context.Context,
+	base option.DialerOptions,
+	interfaceName string,
+) (N.Dialer, error) {
+	return dialer.NewWithOptions(dialer.Options{
+		Context:        ctx,
+		Options:        xdialBoundDNSDialerOptions(base, interfaceName),
+		DirectResolver: true,
+	})
+}
+
+func xdialBoundDNSDialerOptions(base option.DialerOptions, interfaceName string) option.DialerOptions {
+	base.BindInterface = interfaceName
+	return base
+}
