+package local
+
+import (
+	"context"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/option"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+
+	"net"
+)
+
+type xdialFakeDialer struct{ name string }
+
+func (d *xdialFakeDialer) DialContext(context.Context, string, M.Socksaddr) (net.Conn, error) {
+	return nil, nil
+}
+
+func (d *xdialFakeDialer) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
+	return nil, nil
+}
+
+func TestXDialOriginalQueryKeepsTheFlowBoundInterface(t *testing.T) {
+	original := xdialNewBoundDialer
+	t.Cleanup(func() { xdialNewBoundDialer = original })
+	var created []string
+	xdialNewBoundDialer = func(_ context.Context, base option.DialerOptions, interfaceName string) (N.Dialer, error) {
+		if xdialBoundDNSDialerOptions(base, interfaceName).BindInterface != interfaceName {
+			t.Fatal("bound DNS dialer does not bind the flow interface")
+		}
+		created = append(created, interfaceName)
+		return &xdialFakeDialer{name: interfaceName}, nil
+	}
+	defaultDialer := &xdialFakeDialer{name: "default"}
+	transport := &Transport{ctx: context.Background(), dialer: defaultDialer}
+
+	unbound, err := transport.xdialOriginalQueryDialer(adapter.WithContext(context.Background(), &adapter.InboundContext{}))
+	if err != nil || unbound != N.Dialer(defaultDialer) {
+		t.Fatalf("unbound flow must keep the default dialer: %v %v", unbound, err)
+	}
+	ctx := adapter.WithContext(context.Background(), &adapter.InboundContext{XDialBoundInterface: "utun16"})
+	first, err := transport.xdialOriginalQueryDialer(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	second, _ := transport.xdialOriginalQueryDialer(ctx)
+	if first.(*xdialFakeDialer).name != "utun16" || first != second || len(created) != 1 {
+		t.Fatalf("bound flow dialer = %v, created = %v", first, created)
+	}
+}
+
+func TestXDialBoundDNSDialerOptionsOnlyOverridesInterface(t *testing.T) {
+	base := option.DialerOptions{AbstractDialerOptions: option.AbstractDialerOptions{BindInterface: "en1", RoutingMark: 7}}
+	bound := xdialBoundDNSDialerOptions(base, "utun16")
+	if bound.BindInterface != "utun16" || bound.RoutingMark != 7 || base.BindInterface != "en1" {
+		t.Fatalf("unexpected bound options: %+v (base %+v)", bound, base)
+	}
+}
