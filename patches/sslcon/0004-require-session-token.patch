+
+func TestPasswordAuthRequiresSessionToken(t *testing.T) {
+	for _, tc := range []struct {
+		name, xmlToken, cookie, want string
+	}{
+		{"missing", "", "", ""},
+		{"blank", "  ", "", ""},
+		{"xml", "xml-token", "", "xml-token"},
+		{"cookie", "", "cookie-token", "cookie-token"},
+		{"cookie with blank XML", "  ", "cookie-token", "cookie-token"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			client, server := authenticatedTLSPipe(t)
+			defer installAuthTestConnection(t, client)()
+			oldToken, oldCookie := session.Sess.SessionToken, WebVpnCookie
+			defer func() { session.Sess.SessionToken, WebVpnCookie = oldToken, oldCookie }()
+			session.Sess.SessionToken, WebVpnCookie = "previous-token", ""
+			go func() {
+				req, err := http.ReadRequest(bufio.NewReader(server))
+				if err != nil {
+					return
+				}
+				_, _ = io.Copy(io.Discard, req.Body)
+				body := fmt.Sprintf(`<config-auth type="complete"><session-token>%s</session-token></config-auth>`, tc.xmlToken)
+				header := ""
+				if tc.cookie != "" {
+					header = "Set-Cookie: webvpn=" + tc.cookie + "\r\n"
+				}
+				_, _ = fmt.Fprintf(server, "HTTP/1.1 200 OK\r\n%sContent-Length: %d\r\n\r\n%s", header, len(body), body)
+				_, _ = io.Copy(io.Discard, server)
+			}()
+			if err := BeginHandshake(time.Second); err != nil {
+				t.Fatal(err)
+			}
+			err := PasswordAuth()
+			if tc.want == "" {
+				if err == nil || err.Error() != "authentication completed without a session token" {
+					t.Fatalf("unexpected authentication result: %v", err)
+				}
+				return
+			}
+			if err != nil || session.Sess.SessionToken != tc.want {
+				t.Fatal("did not accept the session token")
+			}
+		})
+	}
+}
